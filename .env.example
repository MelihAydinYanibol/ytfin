# Copy to .env and adjust.

# Login (used when authentication is enabled)
YTFIN_USERNAME=admin
YTFIN_PASSWORD=change-me
# Session signing key; set a long random value to keep sessions valid across restarts
YTFIN_SECRET=

# Force authentication on/off regardless of the setting in the UI.
# Leave empty to manage it from Settings. Useful as a recovery switch.
YTFIN_AUTH_ENABLED=

# Where finished videos are written (relative paths are relative to this folder)
YTFIN_DOWNLOAD_DIR=downloads

# Web server
YTFIN_HOST=0.0.0.0
YTFIN_PORT=4999
YTFIN_DEBUG=false
